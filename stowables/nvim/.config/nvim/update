#!/bin/zsh

set -euo pipefail

# Colors for better readability
BOLD='\033[1m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[0;33m'
GRAY='\033[0;90m'
NC='\033[0m' # No Color

SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"
cd "$SCRIPT_DIR" || exit 1

LOCK_FILE="lazy-lock.json"
REPO_LOCK_FILE="$(git rev-parse --show-prefix)$LOCK_FILE"

# Detect lazy.nvim installation path
DATA_PATH=$(nvim --headless -E -u NONE '+lua print(vim.fn.stdpath("data"))' +q 2>&1)
LAZY_PATH="$DATA_PATH/lazy"

run_nvim() {
    local log_file
    log_file=$(mktemp "${TMPDIR:-/tmp}/nvim-update.XXXXXX")

    if ! nvim --headless "$@" +qa > "$log_file" 2>&1; then
        cat "$log_file" >&2
        rm -f "$log_file"
        return 1
    fi

    rm -f "$log_file"
}

echo "${BLUE}${BOLD}==> Starting Neovim plugin update...${NC}"
run_nvim "+Lazy! sync"

echo "${BLUE}${BOLD}==> Updating Mason tools & registries...${NC}"
run_nvim "+MasonToolsUpdateSync"

echo "${BLUE}${BOLD}==> Updating Tree-sitter parsers...${NC}"
run_nvim "+TSUpdate!" '+lua local installer = require("tree-sitter-manager.installer"); local completed = vim.wait(600000, function() return vim.tbl_isempty(installer.installing) end, 100); local failed = {}; for lang, status in pairs(installer.status) do if status.ok == false then failed[#failed + 1] = lang .. ": " .. (status.error or "unknown error") end end; if not completed or #failed > 0 then local message = not completed and "Timed out while updating Tree-sitter parsers" or ("Tree-sitter parser update failed:\n" .. table.concat(failed, "\n")); vim.api.nvim_echo({ { message, "ErrorMsg" } }, true, { err = true }); vim.cmd("cquit 1") end'

if git diff --quiet HEAD -- "$LOCK_FILE"; then
    echo "${GREEN}No plugin lock changes detected.${NC}"
else
    echo "\n${YELLOW}${BOLD}Plugin Update Summary:${NC}"
    echo "========================================"
    
    # Compare the lock file as JSON instead of trying to pair raw diff lines.
    # This avoids bogus plugin names when multiple entries change, are added, or are removed.
    while IFS=$'\t' read -r name old_hash new_hash change_status; do
        # Display Plugin Name and Short Hashes
        short_old=${old_hash:0:7}
        short_new=${new_hash:0:7}
        if [ "$change_status" = "added" ]; then
            short_old="(new)"
        elif [ "$change_status" = "removed" ]; then
            short_new="(removed)"
        fi
        printf "${BLUE}${BOLD}%-30s${NC} ${GRAY}%s -> %s${NC}\n" \
            "$name" "$short_old" "$short_new"

        # Attempt to show git logs for updated plugins
        plugin_dir="$LAZY_PATH/$name"
        if [ "$change_status" = "updated" ] && [ -d "$plugin_dir" ]; then
            git -C "$plugin_dir" log --oneline --no-decorate --color=always \
                ${old_hash}..${new_hash} 2>/dev/null | sed 's/^/    /'
        elif [ "$change_status" = "updated" ]; then
            echo "    ${GRAY}(Plugin directory not found, skipping logs)${NC}"
        fi
        echo ""
    done < <(python3 - "$LOCK_FILE" "$REPO_LOCK_FILE" <<'PY'
import json
import subprocess
import sys

lock_file = sys.argv[1]
repo_lock_file = sys.argv[2]

old_text = subprocess.check_output(["git", "show", f"HEAD:{repo_lock_file}"], text=True)
with open(lock_file, encoding="utf-8") as f:
    new_text = f.read()

old = json.loads(old_text)
new = json.loads(new_text)

for name in sorted(set(old) | set(new)):
    old_hash = old.get(name, {}).get("commit", "")
    new_hash = new.get(name, {}).get("commit", "")
    if old_hash == new_hash:
        continue
    if name not in old:
        status = "added"
    elif name not in new:
        status = "removed"
    else:
        status = "updated"
    print(f"{name}\t{old_hash}\t{new_hash}\t{status}")
PY
    )

    echo "========================================"

    # Commit only the lock file so unrelated staged changes are never included.
    if git commit --only -m "chore: update lazy lock" -- "$LOCK_FILE"; then
        echo "${GREEN}${BOLD}✔ $LOCK_FILE updated and committed successfully.${NC}"
    else
        echo "${YELLOW}${BOLD}Commit failed. $LOCK_FILE changes remain uncommitted.${NC}"
        exit 1
    fi
fi
